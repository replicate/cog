{
  "name": "@replicate/cog-playground-tests",
  "private": true,
  "type": "module",
  "scripts": {
    "fmt": "oxfmt \"$(git rev-parse --show-toplevel)/pkg/cli/playground/app.js\" \"$(git rev-parse --show-toplevel)/pkg/cli/playground/components\" \"$(git rev-parse --show-toplevel)/pkg/cli/playground/lib\" \"$(git rev-parse --show-toplevel)/pkg/cli/playground/worker\" *.js *.json *.md",
    "fmt:check": "oxfmt --check \"$(git rev-parse --show-toplevel)/pkg/cli/playground/app.js\" \"$(git rev-parse --show-toplevel)/pkg/cli/playground/components\" \"$(git rev-parse --show-toplevel)/pkg/cli/playground/lib\" \"$(git rev-parse --show-toplevel)/pkg/cli/playground/worker\" *.js *.json *.md",
    "lint": "oxlint \"$(git rev-parse --show-toplevel)/pkg/cli/playground\" . --ignore-pattern vendor",
    "lint:fix": "oxlint --fix \"$(git rev-parse --show-toplevel)/pkg/cli/playground\" . --ignore-pattern vendor",
    "test": "node --test '*.test.js'",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.50.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": "24.18.0"
  },
  "packageManager": "pnpm@11.11.0"
}
