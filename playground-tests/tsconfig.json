{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2023",
    "types": ["node"]
  },
  "include": ["../pkg/cli/playground/**/*.js", "../pkg/cli/playground/**/*.d.ts", "*.test.js"],
  "exclude": ["../pkg/cli/playground/vendor/*.js"]
}
