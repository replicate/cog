mkdir dist
exec python3 -m zipfile -c dist/local_pkg-0.1.0.zip setup.py local_pkg/__init__.py

# Ensure the import depends on the artifact being installed.
rm local_pkg
rm setup.py

cog build -t $TEST_IMAGE
cog predict $TEST_IMAGE
stdout 'hello from local package 0.1.0'

-- cog.yaml --
build:
  python_version: "3.12"
  python_requirements: requirements.txt
predict: predict.py:Predictor

-- requirements.txt --
./dist/local_pkg-0.1.0.zip

-- setup.py --
from setuptools import setup

setup(name="local-pkg", version="0.1.0", packages=["local_pkg"])

-- local_pkg/__init__.py --
MESSAGE = "hello from local package"

-- predict.py --
from importlib.metadata import version

from cog import BasePredictor

from local_pkg import MESSAGE


class Predictor(BasePredictor):
    def predict(self) -> str:
        return f"{MESSAGE} {version('local-pkg')}"
