# Exercise the full `cog push` bundle path with v1 managed weights:
# cog.yaml weights -> implicit cog weights build -> cog push -> OCI index.
# The pushed artifact is an OCI image index carrying the model image
# manifest plus one weight manifest (application/vnd.cog.weight.v1) per
# cog.yaml entry.

[short] skip 'requires local registry'

registry-start

# Import the weights into the repository that the positional push target
# will use. The tag doesn't affect weight manifests, but keeping it explicit
# makes the setup deterministic.
env COG_MODEL=$TEST_REGISTRY/test/bundle-model:v1

# Two weight directories. Each holds a single small file; the packer
# emits a bundle layer for all the small files under the default
# threshold so we end up with one layer per weight entry.
mkdir weights-alpha
mkdir weights-beta
exec sh -c 'printf AAAA > weights-alpha/data.bin'
exec sh -c 'printf BBBB > weights-beta/data.bin'

# Step 1: import generates weights.lock and pushes weight manifests.
# cog push later requires the lockfile to already exist. Reverse the lockfile
# entries afterward to prove output follows cog.yaml rather than lockfile order.
cog weights import
exec python3 -c 'import json; p="weights.lock"; d=json.load(open(p)); d["weights"].reverse(); open(p, "w").write(json.dumps(d, indent=2) + "\n")'

# Step 2: use the positional target to override a deliberately wrong
# COG_MODEL while keeping the configured bundle format. The positional
# target's repository contains the manifests imported above.
env COG_MODEL=$TEST_REGISTRY/test/ignored:v9
cog push $TEST_REGISTRY/test/bundle-model:v1 --json

# Progress stays on stderr. Stdout is one versioned document containing
# only complete digest references, with weights in cog.yaml order.
stderr 'Pushing to localhost'
! stderr 'model   localhost'
stdout '^\{"version":1,"model":"localhost:[0-9]+/test/bundle-model@sha256:[0-9a-f]{64}","image":"localhost:[0-9]+/test/bundle-model@sha256:[0-9a-f]{64}","weights":\[\{"name":"alpha","reference":"localhost:[0-9]+/test/bundle-model@sha256:[0-9a-f]{64}"\},\{"name":"beta","reference":"localhost:[0-9]+/test/bundle-model@sha256:[0-9a-f]{64}"\}\]\}$'

# Resolve the pushed ref and verify the top-level index shape.
registry-inspect $TEST_REGISTRY/test/bundle-model:v1
stdout 'application/vnd.oci.image.index.v1\+json'
# v1 annotations on each weight descriptor (spec §2.5).
stdout 'run.cog.weight.name.*alpha'
stdout 'run.cog.weight.name.*beta'
stdout 'run.cog.weight.set-digest'

# Positional bundle targets also work without --json. The existing reference
# tree stays on stderr and stdout stays empty.
cog push $TEST_REGISTRY/test/bundle-model:v2
! stdout .
stderr 'model   localhost:[0-9]+/test/bundle-model@sha256:[0-9a-f]{64}'
stderr 'weight  alpha.*localhost:[0-9]+/test/bundle-model@sha256:[0-9a-f]{64}'
stderr 'weight  beta.*localhost:[0-9]+/test/bundle-model@sha256:[0-9a-f]{64}'

# Untagged bundle targets receive a generated timestamp tag while JSON still
# returns immutable digest references.
cog push $TEST_REGISTRY/test/bundle-model --json
stderr 'Pushing to localhost:[0-9]+/test/bundle-model:[0-9]{8}T[0-9]{6}Z'
stdout '^\{"version":1,"model":"localhost:[0-9]+/test/bundle-model@sha256:[0-9a-f]{64}","image":"localhost:[0-9]+/test/bundle-model@sha256:[0-9a-f]{64}","weights":\[\{"name":"alpha","reference":"localhost:[0-9]+/test/bundle-model@sha256:[0-9a-f]{64}"\},\{"name":"beta","reference":"localhost:[0-9]+/test/bundle-model@sha256:[0-9a-f]{64}"\}\]\}$'

# A different repository can't reuse managed weight manifests. Verification
# fails before the model image is pushed and emits no JSON document.
! cog push $TEST_REGISTRY/test/wrong-repository:v1 --json
! stdout .
stderr 'not found in target repository'
stderr 'cog weights import'
! registry-inspect $TEST_REGISTRY/test/wrong-repository:cog-image.v1

# Digest-pinned, reserved, and OCI-invalid positional bundle tags all fail
# before a build starts and leave stdout empty.
! cog push $TEST_REGISTRY/test/bundle-model@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa --json
! stdout .
stderr 'digest-pinned'

! cog push $TEST_REGISTRY/test/bundle-model:cog-image.user --json
! stdout .
stderr 'reserved prefix'

! cog push $TEST_REGISTRY/test/bundle-model:-invalid --json
! stdout .
stderr 'OCI tag regex'

# Command-level output covers one managed weight and no managed weights too.
# Re-importing with the one-weight config updates weights.lock to match it.
env COG_MODEL=$TEST_REGISTRY/test/bundle-model:v1
cog weights import -f cog-one.yaml
cog push $TEST_REGISTRY/test/bundle-model:one-weight --json -f cog-one.yaml
stdout '^\{"version":1,"model":"localhost:[0-9]+/test/bundle-model@sha256:[0-9a-f]{64}","image":"localhost:[0-9]+/test/bundle-model@sha256:[0-9a-f]{64}","weights":\[\{"name":"alpha","reference":"localhost:[0-9]+/test/bundle-model@sha256:[0-9a-f]{64}"\}\]\}$'

cog push $TEST_REGISTRY/test/bundle-model:no-weights --json -f cog-zero.yaml
stdout '^\{"version":1,"model":"localhost:[0-9]+/test/bundle-model@sha256:[0-9a-f]{64}","image":"localhost:[0-9]+/test/bundle-model@sha256:[0-9a-f]{64}"\}$'

-- cog.yaml --
# 'model:' satisfies the schema requirement that weight-bearing configs
# declare a model ref. The full registry/repo:tag target is overridden
# at runtime via COG_MODEL because $TEST_REGISTRY varies per run.
build:
  python_version: "3.12"
predict: "predict.py:Predictor"
model: test/bundle-model
weights:
  - name: alpha
    target: /src/weights-alpha
    source:
      uri: file://./weights-alpha
  - name: beta
    target: /src/weights-beta
    source:
      uri: file://./weights-beta

-- cog-one.yaml --
build:
  python_version: "3.12"
predict: "predict.py:Predictor"
model: test/bundle-model
weights:
  - name: alpha
    target: /src/weights-alpha
    source:
      uri: file://./weights-alpha

-- cog-zero.yaml --
build:
  python_version: "3.12"
predict: "predict.py:Predictor"
model: test/bundle-model

-- predict.py --
from cog import BasePredictor

class Predictor(BasePredictor):
    def predict(self, text: str) -> str:
        return f"processed: {text}"
